{
  "max_count": 2,
  "knobs": [
    {
      "name": "bump_wrong_amount",
      "class": "harness-expectation",
      "applies_to": [
        "L2-1",
        "L2-3"
      ],
      "fails": {
        "L2-1": [
          "event rustCounter.Bumped(value=12) count == 1",
          "last(rustCounter.Counter) == 12"
        ],
        "L2-3": [
          "event rustCounter.Bumped(value=3) count == 1",
          "last(rustMonitor.LastCount) == 3"
        ]
      },
      "mechanism": "harness sends BUMP(amount+1) while the plan expects the planned amounts; the counter, Bumped value and relayed LastCount all move by one",
      "kind": "rewrite",
      "ripples_to": {}
    },
    {
      "name": "bump_zero",
      "class": "uut-state",
      "applies_to": [
        "L5-1"
      ],
      "fails": {
        "L5-1": [
          "event rustCounter.Bumped(value=2) count == 1",
          "event rustCounter.Saturated(value=3, threshold=3) count == 1",
          "last(rustCounter.Counter) == 3"
        ]
      },
      "mechanism": "both planned BUMP(2) are sent as BUMP(0): the counter stays 0, so neither Bumped(2) nor Saturated(3, 3) occurs",
      "kind": "rewrite",
      "ripples_to": {}
    },
    {
      "name": "limit_not_set",
      "class": "uut-state",
      "applies_to": [
        "L2-5"
      ],
      "fails": {
        "L2-5": [
          "event rustMonitor.LimitSet(limit=4) count == 1",
          "event rustMonitor.LimitExceeded(count=10, limit=4) count == 1",
          "delta(rustMonitor.Exceedances) == 1"
        ]
      },
      "mechanism": "the planned SET_LIMIT(4) is sent as SET_LIMIT(4000): the UUT limit is never exceeded by the count 10",
      "kind": "rewrite",
      "ripples_to": {}
    },
    {
      "name": "negative_wrong_limit",
      "class": "stimulus",
      "applies_to": [
        "L6-1"
      ],
      "fails": {
        "L6-1": [
          "event rustMonitor.InvalidLimit(limit=0) count == 1",
          "event CdhCore.cmdDisp.OpCodeError(error=VALIDATION_ERROR) count == 1",
          "event rustMonitor.LimitSet count == 0"
        ]
      },
      "mechanism": "the negative control sends SET_LIMIT(1) instead of SET_LIMIT(0): the command is accepted, so the expected rejection never happens (the limit is left at 1; L7-1 sends count 0, which does not exceed it)",
      "kind": "rewrite",
      "ripples_to": {}
    },
    {
      "name": "skip_reset",
      "class": "stimulus",
      "applies_to": [
        "L2-1",
        "L7-1"
      ],
      "fails": {
        "L2-1": [
          "event rustCounter.ResetIssued count == 1",
          "event rustCounter.ResetIssued precedes event rustCounter.Bumped(value=7)"
        ],
        "L7-1": [
          "event rustCounter.ResetIssued count == 1",
          "delta(relay.Relayed) == 1"
        ]
      },
      "mechanism": "the planned RESET is replaced by CdhCore.cmdDisp.CMD_NO_OP, so no ResetIssued event and no count travels the port chain",
      "kind": "insert",
      "ripples_to": {}
    },
    {
      "name": "threshold_not_set",
      "class": "uut-state",
      "applies_to": [
        "L2-2"
      ],
      "fails": {
        "L2-2": [
          "event rustCounter.Saturated(value=5, threshold=5) count == 1",
          "last(rustCounter.Counter) == 5",
          "event rustCounter.Bumped count == 0"
        ]
      },
      "mechanism": "the planned THRESHOLD_PRM_SET(5) is sent as THRESHOLD_PRM_SET(100): the UUT keeps the default threshold and BUMP(9) does not saturate",
      "kind": "rewrite",
      "ripples_to": {}
    }
  ],
  "tests_covered": [
    "L2-1",
    "L2-2",
    "L2-3",
    "L2-5",
    "L5-1",
    "L6-1",
    "L7-1"
  ]
}
